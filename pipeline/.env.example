# 실제 값은 .env에 두고 절대 커밋하지 않는다 (.gitignore에 포함).
# DB URL은 반드시 Session pooler(:5432) 문자열을 쓴다 — direct 주소는 IPv6 전용.
SUPABASE_DB_URL=postgresql://postgres.{ref}:{password}@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://{ref}.supabase.co
SUPABASE_SERVICE_ROLE_KEY={service_role}
